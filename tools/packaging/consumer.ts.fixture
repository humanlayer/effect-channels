import { emptyMailbox, MailboxReadiness, MailboxStore } from '@humanlayer/channels-delivery'
import * as DeliveryMemory from '@humanlayer/channels-delivery/memory'
import { MarkdownContent, Slack, SlackConnectionStore, SlackSubscriptions, SlackTeamId, ThreadId } from '@humanlayer/channels-slack'
import * as SlackMemory from '@humanlayer/channels-slack/memory'
import { Context, Effect, Layer, Redacted } from 'effect'
import { GitHub, GitHubCredentials, GitHubCrypto, GitHubIssueRef, GitHubEmoji, GitHubReactionContent, type GitHubReaction, type GitHubReactionRef, type GitHubReactionTarget, type GitHubError, type AddReactionInput, type ListReactionsInput, type RemoveReactionInput } from '@humanlayer/channels-github'
import { FetchHttpClient } from 'effect/unstable/http'
import { GitHubSubscriptions } from '@humanlayer/channels-github'
import * as GitHubMemory from '@humanlayer/channels-github/memory'
import { GitHubBot, GitHubIngress, GitHubIngressError, GitHubSubscriptionStore, type GitHubHandlerRegistration, type GitHubActivityEvent } from '@humanlayer/channels-github'
import { type DeliveryPolicy } from '@humanlayer/channels-delivery'
import { HttpClient } from 'effect/unstable/http'
// @ts-expect-error Removed registration name; there is no compatibility export.
import type { GitHubActivityRegistration } from '@humanlayer/channels-github'
// @ts-expect-error Removed legacy delivery definition; the native parser is not an ingress pipeline.
import type { issueEventDefinition } from '@humanlayer/channels-github'

class FirstHandlerDependency extends Context.Service<FirstHandlerDependency, { readonly value: string }>()('packed/FirstHandlerDependency') {}
class SecondHandlerDependency extends Context.Service<SecondHandlerDependency, { readonly value: number }>()('packed/SecondHandlerDependency') {}

export const githubHandlers = (policy: DeliveryPolicy) => {
	const bot = GitHubBot.make({
		namespace: 'packed', policy,
		handlers: [{
			id: 'first',
			onCreation: (event, context) => {
				const action: 'opened' = event.action
				const organizationId: string = context.organizationId
				const skipped: ReadonlyArray<GitHubActivityEvent> = context.skipped
				if (event.event === 'pull_request') {
					const kind: 'github.pull-request' = event.resource.kind
					const body: string | null = event.pull_request.body
					// @ts-expect-error Native PR events do not fabricate an issue snapshot.
					event.issue
				}
				return Effect.andThen(FirstHandlerDependency, Effect.fail('first' as const))
			},
			onMention: (event) => {
				const action: 'opened' | 'created' | 'edited' | 'submitted' = event.action
				return Effect.andThen(SecondHandlerDependency, Effect.fail(42 as const))
			},
		}, {
			id: 'second',
			onSubscribedEvent: (event) => {
				if (event.event === 'pull_request_review_thread') {
					const nodeId: string = event.thread.node_id
					// @ts-expect-error A review thread is not a discussion comment.
					event.comment
				}
				return Effect.void
			},
		}],
	})
	type Requirements = FirstHandlerDependency | SecondHandlerDependency | MailboxStore | MailboxReadiness | GitHubSubscriptionStore | GitHubCredentials | HttpClient.HttpClient
	const services: Layer.Layer<GitHub | GitHubIngress, GitHubIngressError, Requirements> = bot.services
	// @ts-expect-error Required callback services must not disappear or become optional.
	const missing: Layer.Layer<GitHub | GitHubIngress, GitHubIngressError, Exclude<Requirements, SecondHandlerDependency>> = bot.services
	// @ts-expect-error Ingress configuration failures are typed, not never.
	const noErrors: Layer.Layer<GitHub | GitHubIngress, never, Requirements> = bot.services
	const partial = GitHubBot.make({ namespace: 'partial', policy, handlers: [], runner: { pollMs: 50 } })
	const empty: Layer.Layer<GitHub | GitHubIngress, GitHubIngressError, Exclude<Requirements, FirstHandlerDependency | SecondHandlerDependency>> = partial.services
	const registration: GitHubHandlerRegistration<'first' | 42, FirstHandlerDependency | SecondHandlerDependency> = {
		id: 'typed',
		onCreation: () => Effect.andThen(FirstHandlerDependency, Effect.fail('first' as const)),
		onMention: () => Effect.andThen(SecondHandlerDependency, Effect.fail(42 as const)),
	}
	const typed = GitHubBot.make({ namespace: 'typed', policy, handlers: [registration] })
	const typedServices: typeof services = typed.services
	return { services, empty, typedServices }
}

export const rejectedGitHubForms = (policy: DeliveryPolicy, ingress: GitHubIngress['Service']) => {
	// @ts-expect-error The old property is not an alias, even alongside canonical handlers.
	GitHubBot.make({ namespace: 'old', policy, handlers: [], activityHandlers: [] })
	// @ts-expect-error Bare issue-event handlers are removed.
	GitHubBot.make({ namespace: 'old', policy, handlers: [{ id: 'old', handler: () => Effect.void }] })
	// @ts-expect-error Mixing old and new callback fields is rejected too.
	GitHubBot.make({ namespace: 'old', policy, handlers: [{ id: 'old', onCreation: () => Effect.void, handler: () => Effect.void }] })
	// @ts-expect-error Ingress has the same sole registration API.
	GitHubIngress.layer({ namespace: 'old', policy, handlers: [{ id: 'old', handler: () => Effect.void }] })
	// @ts-expect-error No alternate activityHandlers ingress mode.
	GitHubIngress.layer({ namespace: 'old', policy, handlers: [], activityHandlers: [] })
	// @ts-expect-error Removed legacy admission operation.
	ingress.accept
	// @ts-expect-error Removed legacy processing operation.
	ingress.process
	// @ts-expect-error Routes cannot select an old pipeline.
	ingress.activityEnabled
}

export const githubSubscriptionRoundTrip = Effect.gen(function* () {
	const subscriptions = yield* GitHubSubscriptions
	const input = { namespace: 'packed', resource: GitHubIssueRef.make({ kind: 'github.issue', repository: { kind: 'github.repository', installationId: 100, id: 1, owner: 'owner', name: 'repo' }, number: 1 }) }
	yield* subscriptions.subscribe(input)
	const subscribed = yield* subscriptions.isSubscribed(input)
	yield* subscriptions.unsubscribe(input)
	return { subscribed, removed: !(yield* subscriptions.isSubscribed(input)) }
}).pipe(Effect.provide(GitHubMemory.subscriptions()))

const readyForHost = <A, E>(program: Effect.Effect<A, E>) => program
const githubLayer = GitHub.layer.pipe(Layer.provide(GitHubCredentials.layer({ appId: 42, privateKey: Redacted.make('not-used-during-construction'), installationIds: [100], botUserId: 99, apiUrl: 'https://api.github.com' }).pipe(Layer.provide(GitHubCrypto.layerWebCrypto), Layer.provide(FetchHttpClient.layer))), Layer.provide(FetchHttpClient.layer))
export const githubOutbound = readyForHost(Effect.flatMap(GitHub, (github) => github.getIssue({ issue: GitHubIssueRef.make({ kind: 'github.issue', repository: { kind: 'github.repository', installationId: 100, id: 1, owner: 'owner', name: 'repo' }, number: 1 }) })).pipe(Effect.provide(githubLayer)))
export const githubIdentity = Effect.scoped(Layer.build(githubLayer).pipe(Effect.map((context) => Context.get(context, GitHub))))
export const githubRejectsSlack = (github: GitHub['Service'], threadId: ThreadId) => {
	// @ts-expect-error Slack IDs are not GitHub issue handles.
	return github.getIssue({ issue: threadId })
}
export const githubReactions = (github: GitHub['Service'], target: GitHubReactionTarget, reaction: GitHubReactionRef) => {
	const emoji: GitHubEmoji = GitHubEmoji.Eyes
	const native: GitHubReactionContent = '+1'
	const add: AddReactionInput = { target, content: emoji }
	const list: ListReactionsInput = { target, page: 1, perPage: 100, content: GitHubEmoji.ThumbsUp }
	GitHubReactionContent.make(native)
	// @ts-expect-error GitHub has no custom emoji constructor.
	GitHubEmoji.custom('party_parrot')
	// @ts-expect-error Named values preserve their exact native literal types.
	const wrong: typeof GitHubEmoji.ThumbsUp = 'eyes'
	const remove: RemoveReactionInput = { reaction }
	const added: Effect.Effect<GitHubReaction, GitHubError> = github.addReaction(add)
	const listed: Effect.Effect<ReadonlyArray<GitHubReaction>, GitHubError> = github.listReactions(list)
	const removed: Effect.Effect<void, GitHubError> = github.removeReaction(remove)
	// @ts-expect-error No Slack reaction aliases or arbitrary emoji.
	github.addReaction({ target, content: 'thumbsup' })
	// @ts-expect-error Bounded pagination must be explicit.
	github.listReactions({ target })
	// @ts-expect-error Removing requires a target-scoped native reaction ref, not a number.
	github.removeReaction({ reaction: 70 })
	// @ts-expect-error PR review comments are outside this slice.
	github.addReaction({ target: { kind: 'github.review-comment', id: 1 }, content: GitHubEmoji.Eyes })
	// @ts-expect-error Commit reactions are outside this slice.
	github.addReaction({ target: { kind: 'github.commit', sha: 'abc' }, content: GitHubEmoji.Eyes })
	return { added, listed, removed }
}
export const outbound = readyForHost(Effect.flatMap(Slack, (slack) => slack.post({
	threadId: ThreadId.make('slack:v1:T_PACKAGING:C_PACKAGING:100.1'),
	content: MarkdownContent.make({ markdown: 'Hello' }),
})).pipe(Effect.provide(Slack.layerFromStore.pipe(
	Layer.provide(SlackMemory.connections()),
	Layer.provide(FetchHttpClient.layer),
))))

export const deliveryIdentity = Effect.scoped(
	Effect.gen(function* () {
		const context = yield* Layer.build(DeliveryMemory.layer({ maxMailboxes: 2 }))
		const store = Context.get(context, MailboxStore)
		const readiness = Context.get(context, MailboxReadiness)
		const committed = yield* store.commitMailbox({ key: 'packaging', expectedRevision: null, nextState: emptyMailbox() })
		const snapshot = yield* store.loadMailbox({ key: 'packaging' })
		const ready = yield* readiness.scanReady({ prefix: '', now: 0, limit: 1 })
		return { committed, snapshot, ready }
	}),
)

export const slackIdentity = Effect.scoped(
	Effect.gen(function* () {
		const context = yield* Layer.build(SlackMemory.layer({ maxMailboxes: 2 }))
		const store = Context.get(context, MailboxStore)
		const readiness = Context.get(context, MailboxReadiness)
		const connections = Context.get(context, SlackConnectionStore)
		const subscriptions = Context.get(context, SlackSubscriptions)
		const threadId = ThreadId.make('packaging-thread')
		const committed = yield* store.commitMailbox({ key: 'slack', expectedRevision: null, nextState: emptyMailbox() })
		const snapshot = yield* store.loadMailbox({ key: 'slack' })
		const ready = yield* readiness.scanReady({ prefix: '', now: 0, limit: 1 })
		const connection = yield* connections.get({ workspaceId: SlackTeamId.make('T_PACKAGING') })
		yield* subscriptions.subscribe({ threadId })
		const subscribed = yield* subscriptions.isSubscribed({ threadId })
		return { committed, snapshot, ready, connection, subscribed }
	}),
)
