{
	"name": "humanlayer-channels",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"test:live:slack": "bun run --cwd examples/slack-thread-echo live",
		"check": "bun run lint && bun run typecheck && bun run check:typed",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --oxlint",
		"test:backend:postgres": "PHASE2_BACKEND=postgres bun run tools/test-backends.ts",
		"test:backend:redis": "PHASE2_BACKEND=redis bun run tools/test-backends.ts",
		"check:typed": "node --import tsx tools/typed/src/cli.ts check --config typed-lint.config.ts",
		"check:diff": "node --import tsx tools/diff-check/src/main.ts --config tools/diff-check/diff-check.config.json"
	},
	"devDependencies": {
		"@effect/language-service": "0.87.2",
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "0.45.0",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "1.81.0",
		"@types/bun": "catalog:",
		"effect": "catalog:",
		"emulate": "catalog:",
		"oxlint": "1.81.0",
		"eslint-plugin-better-tailwindcss": "4.7.0",
		"fast-glob": "3.3.3",
		"oxlint-tsgolint": "7.0.2001",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "catalog:",
		"typescript-compiler": "npm:typescript@6.0.2",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
		"vite-plus": "0.3.1",
		"vitest": "catalog:"
	},
	"overrides": {
		"@effect/opentelemetry": "4.0.0-rc.112",
		"@effect/platform-browser": "4.0.0-rc.112",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/platform-node-shared": "4.0.0-rc.112",
		"@effect/sql-d1": "4.0.0-rc.112",
		"@effect/sql-pg": "4.0.0-rc.112",
		"@effect/sql-sqlite-do": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"effect": "4.0.0-rc.112",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.1"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"alchemy": "2.0.0-beta.76",
		"effect": "4.0.0-rc.112",
		"@effect/opentelemetry": "4.0.0-rc.112",
		"@effect/platform-browser": "4.0.0-rc.112",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/sql-d1": "4.0.0-rc.112",
		"@effect/sql-pg": "4.0.0-rc.112",
		"@effect/sql-sqlite-do": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"emulate": "0.11.2",
		"vitest": "4.1.11",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10"
	}
}