{
	"name": "humanlayer-channels",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp run -r test",
		"test:live:slack": "bun run --cwd examples/slack-thread-echo live",
		"record:slack": "bun run --cwd examples/slack-thread-echo record",
		"check": "vp check",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --oxlint"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "0.38.0",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "1.80.0",
		"@types/bun": "catalog:",
		"effect": "catalog:",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "catalog:",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vite-plus": "0.3.0",
		"vitest": "catalog:"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"effect": "4.0.0-rc.110",
		"@effect/opentelemetry": "4.0.0-rc.110",
		"@effect/platform-browser": "4.0.0-rc.110",
		"@effect/platform-bun": "4.0.0-rc.110",
		"@effect/platform-node": "4.0.0-rc.110",
		"@effect/sql-pg": "4.0.0-rc.110",
		"@effect/vitest": "4.0.0-rc.110",
		"vitest": "4.1.10",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10"
	}
}
