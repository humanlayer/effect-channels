{
	"name": "humanlayer-channels",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"check": "vp check && bun run check:typed",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --oxlint",
		"check:typed": "node --import tsx tools/typed/src/cli.ts check --config typed-lint.config.ts",
		"check:diff": "node --import tsx tools/diff-check/src/main.ts --config tools/diff-check/diff-check.config.json"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/tsgo": "0.38.0",
		"@oxlint/plugins": "1.80.0",
		"@types/bun": "catalog:",
		"eslint-plugin-better-tailwindcss": "4.7.0",
		"fast-glob": "3.3.3",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.12",
		"typescript": "catalog:",
		"typescript-compiler": "npm:typescript@6.0.2",
		"vite-plus": "0.3.0",
		"vitest": "catalog:"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"effect": "4.0.0-rc.110",
		"@effect/opentelemetry": "4.0.0-rc.110",
		"@effect/platform-browser": "4.0.0-rc.110",
		"@effect/platform-bun": "4.0.0-rc.110",
		"@effect/platform-node": "4.0.0-rc.110",
		"@effect/vitest": "4.0.0-rc.110",
		"vitest": "4.1.10",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10"
	}
}
