{
	"name": "humanlayer-channels",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"dev": "vp run -r --parallel dev",
		"test": "vp test",
		"test:live:slack": "bun run --cwd examples/slack-thread-echo live",
		"check": "bun run verify:imports && bun run build:lint && vp check",
		"build:lint": "bun build ./tools/oxlint/anti-slop/index.ts ./tools/oxlint/anti-slop/effect/index.ts --outdir ./tools/oxlint/dist --target node --external @oxlint/plugins",
		"lint": "bun run verify:imports && bun run build:lint && vp lint",
		"lint:fix": "bun run build:lint && vp lint --fix",
		"format": "vp fmt --check",
		"format:write": "vp fmt --write",
		"typecheck": "vp run -r typecheck",
		"prepare": "effect-tsgo patch --oxlint && bun run build:lint",
		"verify:exports": "bun run tools/verify-package-exports.ts",
		"verify:imports": "node tools/verify-import-extensions.mjs",
		"test:backend:postgres": "PHASE2_BACKEND=postgres bun run tools/test-backends.ts",
		"test:backend:redis": "PHASE2_BACKEND=redis bun run tools/test-backends.ts"
	},
	"devDependencies": {
		"@effect/language-service": "0.86.2",
		"@effect/platform-node": "catalog:",
		"@effect/tsgo": "0.38.0",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "1.80.0",
		"@types/bun": "catalog:",
		"effect": "catalog:",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "catalog:",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vite-plus": "0.3.0",
		"vitest": "catalog:"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0"
	},
	"packageManager": "bun@1.3.14",
	"catalog": {
		"alchemy": "2.0.0-beta.76",
		"effect": "4.0.0-rc.112",
		"@effect/opentelemetry": "4.0.0-rc.112",
		"@effect/platform-browser": "4.0.0-rc.112",
		"@effect/platform-bun": "4.0.0-rc.112",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/sql-pg": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"vitest": "4.1.11",
		"typescript": "7.0.2",
		"@types/bun": "^1.3.10"
	}
}
