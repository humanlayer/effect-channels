PORT=3000
REDIS_URL=redis://127.0.0.1:56380
# Used only by the Postgres or mixed storage recipe.
DATABASE_URL=postgres://slack_example:local-example-only@127.0.0.1:55433/slack_example
SLACK_SIGNING_SECRET=replace-me
# The seed command reads these; normal server startup reads the saved connection.
SLACK_TEAM_ID=T_REPLACE_ME
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_BOT_USER_ID=U_REPLACE_ME
SLACK_BOT_ID=B_REPLACE_ME
