{
	"_metadata": {
		"major_version": 2,
		"minor_version": 1
	},
	"display_information": {
		"name": "Channels Thread Echo",
		"description": "Credentialed acceptance app for Effect-native Slack threads",
		"background_color": "#1f2937"
	},
	"features": {
		"app_home": {
			"home_tab_enabled": false,
			"messages_tab_enabled": true,
			"messages_tab_read_only_enabled": false
		},
		"bot_user": {
			"display_name": "Channels Thread Echo",
			"always_online": true
		},
		"agent_view": {
			"agent_description": "Validates threaded channel behavior, history, and agent status cleanup."
		}
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"app_mentions:read",
				"channels:history",
				"channels:read",
				"chat:write",
				"chat:write.public",
				"files:read",
				"files:write",
				"groups:history",
				"groups:read",
				"im:history",
				"im:read",
				"im:write",
				"mpim:history",
				"mpim:read",
				"mpim:write",
				"reactions:read",
				"reactions:write",
				"users:read",
				"users:read.email",
				"assistant:write"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://replace-with-your-tunnel.example/api/v1/integrations/slack/webhook",
			"bot_events": [
				"agent_session_stopped",
				"app_mention",
				"message.channels",
				"message.groups",
				"message.im",
				"message.mpim",
				"reaction_added",
				"reaction_removed"
			]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
