{
	"_metadata": {
		"major_version": 2,
		"minor_version": 1
	},
	"display_information": {
		"name": "Channels Thread Echo",
		"description": "Credentialed acceptance app for Effect-native Slack threads",
		"background_color": "#1f2937"
	},
	"features": {
		"bot_user": {
			"display_name": "Channels Thread Echo",
			"always_online": true
		},
		"agent_view": {
			"agent_description": "Validates threaded channel behavior, history, and agent status cleanup."
		}
	},
	"oauth_config": {
		"scopes": {
			"bot": [
				"app_mentions:read",
				"channels:history",
				"channels:read",
				"chat:write",
				"chat:write.public",
				"files:read",
				"files:write",
				"groups:history",
				"groups:read",
				"im:history",
				"mpim:history",
				"users:read",
				"users:read.email",
				"assistant:write"
			]
		}
	},
	"settings": {
		"event_subscriptions": {
			"request_url": "https://replace-with-your-tunnel.example/api/v1/integrations/slack/webhook",
			"bot_events": ["agent_session_stopped", "app_mention", "message.channels", "message.groups"]
		},
		"org_deploy_enabled": false,
		"socket_mode_enabled": false,
		"token_rotation_enabled": false
	}
}
