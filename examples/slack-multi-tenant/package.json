{
	"name": "example-slack-multi-tenant",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun build ./src/server.ts --outdir ./dist --target bun --format esm --packages external",
		"start": "bun run ./src/server.ts",
		"seed": "bun run ./scripts/seed.ts",
		"test": "vp test --root ../.. examples/slack-multi-tenant/test/",
		"test:postgres": "vp test --config ./vitest.postgres.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@effect/platform-node": "catalog:",
		"@effect/sql-pg": "catalog:",
		"@humanlayer/channels-delivery": "workspace:*",
		"@humanlayer/channels-slack": "workspace:*",
		"effect": "catalog:"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:",
		"@types/bun": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
